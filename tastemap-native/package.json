{
  "name": "tastemap-native",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "native": "cd apps/expo && yarn start",
    "watch": "yarn workspaces foreach --all -pi run watch",
    "vercel:install": "yarn set version 3.5 && yarn install",
    "web": "yarn build && cd apps/next && yarn next",
    "web:extract": "DISABLE_EXTRACTION=false yarn workspace next-app dev",
    "web:prod": "yarn workspace next-app build",
    "web:prod:serve": "yarn workspace next-app serve",
    "fix": "manypkg fix",
    "postinstall": "yarn check-deps && yarn build",
    "build": "yarn workspaces foreach --all --exclude next-app run build",
    "upgrade:tamagui": "yarn up '*tamagui*'@latest '@tamagui/*'@latest react-native-web-lite@latest",
    "upgrade:tamagui:canary": "yarn up '*tamagui*'@canary '@tamagui/*'@canary react-native-web-lite@canary",
    "check-deps": "check-dependency-version-consistency .",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "resolutions": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-refresh": "^0.14.0",
    "react-native-svg": "13.9.0",
    "react-native-web": "~0.19.6"
  },
  "dependencies": {
    "@babel/core": "^7.20.0",
    "@babel/runtime": "^7.18.9",
    "@manypkg/cli": "^0.19.1",
    "@types/node-fetch": "^2.6.11",
    "check-dependency-version-consistency": "^3.0.3",
    "eslint": "^8.21.0",
    "expo": "~49.0.23",
    "expo-build-properties": "~0.8.3",
    "expo-splash-screen": "~0.20.5",
    "expo-status-bar": "~1.6.0",
    "expo-updates": "~0.18.19",
    "node-fetch": "2.7.0",
    "node-gyp": "^9.3.1",
    "patch-package": "^8.0.0",
    "prettier": "^2.7.1",
    "react": "^18.2.0",
    "react-native": "0.72.10",
    "react-native-fetch-api": "^3.0.0",
    "react-native-polyfill-globals": "^3.1.0",
    "simple-line-notify": "^2.0.0",
    "text-encoding": "^0.7.0",
    "turbo": "^1.10.3",
    "typescript": "^5.1.3",
    "web-streams-polyfill": "^3.2.1",
    "zod": "^3.22.4"
  },
  "packageManager": "yarn@3.6.3",
  "version": "1.0.0"
}
